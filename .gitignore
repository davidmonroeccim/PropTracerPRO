# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Purchased skip-trace research artifacts. Contain PII for real individuals
# (names, DOBs, phones, emails) bought from Tracerfy/FastAppend. Never commit.
tasks/research-test/

# Agent worktrees. Each holds a FULL duplicate copy of the repo, so a `git add -A`
# without this would commit thousands of stray files and make any grep-based
# sweep of the codebase look like it missed half its targets.
.claude/worktrees/

# Supabase CLI scratch state (linked project ref, temp files). Machine-local.
supabase/.temp/
